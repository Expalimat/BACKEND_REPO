# Environment variables to add in Render (Web Service > Environment)
APP_NAME=PnC-OESS
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # run: php artisan key:generate --show   (paste the base64:... value)
APP_URL=https://your-service.onrender.com

DB_CONNECTION=pgsql
DB_URL=                       # Render Postgres "Internal Database URL"
DB_SSLMODE=require            # encrypts the API to database connection (remove if the app cannot connect)

SESSION_DRIVER=array
CACHE_STORE=file              # MUST NOT be "array": the login lockout / rate limits need a real cache
QUEUE_CONNECTION=sync
LOG_CHANNEL=stderr
LOG_LEVEL=warning
BCRYPT_ROUNDS=12

# CORS: only this site may call the API from a browser (comma-separate several, no trailing slash)
FRONTEND_URL=https://your-frontend.vercel.app
